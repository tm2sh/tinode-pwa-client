# Public build configuration. Copy this file to .env.local to use your own values.
# VITE_* values are included in the browser's JavaScript.
# Keep passwords, verification codes, and session tokens out of this file.

# Enter a hostname with an optional port. The SDK always connects over WSS.
VITE_TINODE_HOST=sandbox.tinode.co

# Public application key from the official Tinode web app configuration.
# This key identifies the application independently of the signed-in account.
VITE_TINODE_API_KEY=AQEAAAABAAD_rAp4DJh05a1HAwFT3A6K

# Use ./, the site root /, or a deployment path such as /tinode-pwa-client/.
VITE_APP_BASE=./

# Independent UI flags. Use lowercase true or false.
VITE_REGISTRATION_ENABLED=true
VITE_CHAT_CREATION_ENABLED=true

# Language for static build metadata. Use ru (default) or en.
VITE_UI_LANGUAGE=ru
